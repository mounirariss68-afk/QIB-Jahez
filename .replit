modules = ["nodejs-20", "postgresql-16", "python-base-3.13"]
run = "bash tools/replit-run.sh"
entrypoint = "apps/server/src/index.ts"

[nix]
channel = "stable-24_05"

[env]
PORT = "5000"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "-c", "npm install --include=dev --no-audit --no-fund && npm run build"]
run = ["npm", "start"]
